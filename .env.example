# Copy to .env.local (git-ignored) and fill in. Read by the local relay in vite-relay.ts only; never sent to the browser.
# Restart the dev server (Run TURNPOINT.bat) after editing.

# Backend (server/index.mjs, deployed only; dev uses the Vite relay and ignores these)
# PORT=4303
# CORS_ORIGIN=https://turnpoint.astrikos.xyz:8443
# RATE_LIMIT_PER_MIN=60

# AI assistant (Claude). Without it the assistant answers with the on-device engine.
ANTHROPIC_API_KEY=

# SAP Business Accelerator Hub sandbox key (api.sap.com > Settings > Show API Key). Without it the SAP sandbox tab stays in demo mode.
SAP_API_KEY=
